#define LDS_SIZE (64 * 1024)

__device__ inline unsigned int min__(uint32_t a, uint32_t b) { return min(a, b); }

template <typename T>
__device__ __forceinline__ T loadnt(T* addr) {
  return __builtin_nontemporal_load(addr);
}

static int mindiv(int N, int div1, int div2) {
  int nPrRnd = div1 * div2;
  int rnds[13];
  for (int i = 0; i < 13; i++) {
    rnds[i] = (N + nPrRnd - 1) / nPrRnd;
    nPrRnd -= div1;
  }
  for (int i = 12; i >= 0; i--)
    if (rnds[0] == rnds[i]) return (div2 - i);
  return 0;
}

template <int THRDS, int YTILE, int WvPrGrp, int UNRL, int N>
__global__ void __launch_bounds__(WvPrGrp* THRDS)
    wvSplitK_i8_(const int K, const int Kap, const int Kbp, const int M,
                 const int8_t* __restrict__ B, const __hip_bfloat16* __restrict__ A,
                 const float* __restrict__ S, __hip_bfloat16* __restrict__ C,
                 const int _WvPrGrp, const int CuCount) {
#if defined(__HIP__GFX1X__)
  constexpr int A_CHUNK = 16;                  // K elements per lane per step
  constexpr int max_lds_len = LDS_SIZE / 2;    // BF16 elements
  using vec16 = __attribute__((__vector_size__(4 * sizeof(int)))) int;
  union bigB_t {
    vec16 v;
    int8_t b[16];
  };
  union bigA_t {
    vec16 v[2];
    uint32_t u[8];
