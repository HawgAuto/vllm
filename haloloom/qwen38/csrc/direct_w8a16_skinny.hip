  TORCH_CHECK(in_s.dtype() == torch::kFloat32 && in_s.dim() == 1, "scale fp32 [M]");
  TORCH_CHECK(in_x.dtype() == torch::kBFloat16 && in_x.dim() == 2, "x bf16 [N,K]");
  const int64_t M_in = in_w.size(0), K_in = in_w.size(1), N_in = in_x.size(0);
  const int64_t Kbp_in = in_w.stride(0), Kap_in = in_x.stride(0);
