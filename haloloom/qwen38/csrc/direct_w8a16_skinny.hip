  TORCH_CHECK(M_in * Kbp_in < (int64_t(1) << 32) && Kap_in * N_in < (int64_t(1) << 31), "32-bit offsets");
  TORCH_CHECK(M_in % ytile == 0, "M % YTILE == 0");
  TORCH_CHECK(in_w.device() == in_x.device() && in_s.device() == in_x.device());

  auto out_c = torch::empty({N_in, M_in},
                            torch::TensorOptions().dtype(torch::kBFloat16).device(in_x.device()));
  const at::cuda::OptionalCUDAGuard device_guard(device_of(in_x));
  const hipStream_t stream = at::cuda::getCurrentCUDAStream();
  dim3 grid(CuCount);
  const int8_t* w = reinterpret_cast<const int8_t*>(in_w.data_ptr());
  const __hip_bfloat16* x = reinterpret_cast<const __hip_bfloat16*>(in_x.data_ptr());
  const float* sc = in_s.data_ptr<float>();
  __hip_bfloat16* c = reinterpret_cast<__hip_bfloat16*>(out_c.data_ptr());

  bool launched = false;
#define W8_CFG(_YT, _UN, _N)                                                       \
  if (!launched && ytile == _YT && unrl == _UN && N_in == _N) {                    \
    dim3 block(32, 16);                                                            \
    int wvPrGrp = mindiv(M_in, CuCount * _YT, 16);                                 \
   hipLaunchKernelGGL(( wvSplitK_i8_<32, _YT, 16, _UN, _N>), dim3(grid), dim3(block), 0, stream,                 \
        K_in, Kap_in, Kbp_in, M_in, w, x, sc, c, wvPrGrp, CuCount);                \
    launched = true;                                                               \
  }
#define W8_N(_YT, _UN) W8_CFG(_YT, _UN, 1) W8_CFG(_YT, _UN, 2) W8_CFG(_YT, _UN, 3) W8_CFG(_YT, _UN, 4)
  W8_N(1, 1) W8_N(1, 2) W8_N(1, 4)
  W8_N(2, 1) W8_N(2, 2) W8_N(2, 4)
  W8_N(4, 1) W8_N(4, 2) W8_N(4, 4)
#undef W8_N
#undef W8_CFG
  TORCH_CHECK(launched, "unsupported (ytile, unrl, N)");
  return out_c;
}

