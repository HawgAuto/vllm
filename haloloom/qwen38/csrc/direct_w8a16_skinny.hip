  __shared__ __hip_bfloat16 s[max_lds_len];

  for (uint32_t k = (threadIdx.y * THRDS + threadIdx.x) * 8;
       k < min__(Kap * N, max_lds_len); k += THRDS * WvPrGrp * 8) {
    *((vec16*)(&s[k])) = *((const vec16*)(&A[k]));
