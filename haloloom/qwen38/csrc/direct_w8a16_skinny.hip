  __syncthreads();

  if (threadIdx.y >= _WvPrGrp) return;

  uint32_t m = (blockIdx.x * _WvPrGrp + (threadIdx.y % _WvPrGrp)) * YTILE;

  while (m < M) {
    float sum[N][YTILE] = {};

    for (uint32_t k1 = 0; k1 < K; k1 += THRDS * A_CHUNK * UNRL) {
      bigA_t bigA[N][UNRL] = {};
      bigB_t bigB[YTILE][UNRL];
  #pragma unroll
      for (uint32_t k2 = 0; k2 < UNRL; k2++) {
        uint32_t k = k1 + k2 * THRDS * A_CHUNK;
        uint32_t k_ = k + threadIdx.x * A_CHUNK;
        const int8_t* B_ = &B[min__(k_, K - A_CHUNK)];
        for (int y = 0; y < YTILE; y++)
          bigB[y][k2].v = loadnt((vec16*)(&B_[min__(y + m, M - 1) * Kbp]));
      }
  #pragma unroll
      for (uint32_t k2 = 0; k2 < UNRL; k2++) {
        uint32_t k = k1 + k2 * THRDS * A_CHUNK;
        uint32_t k_ = k + threadIdx.x * A_CHUNK;
        if (k_ >= K) break;
        for (int n = 0; n < N; n++) {
          const uint32_t off = k_ + Kap * n;
          if (off < max_lds_len) {
            bigA[n][k2].v[0] = *((const vec16*)(&s[off]));
            bigA[n][k2].v[1] = *((const vec16*)(&s[off + 8]));
          } else {
            bigA[n][k2].v[0] = *((const vec16*)(&A[off]));
            bigA[n][k2].v[1] = *((const vec16*)(&A[off + 8]));
          }
        }
      }
      for (uint32_t n = 0; n < N; n++) {
        for (uint32_t k2 = 0; k2 < UNRL; k2++) {
          for (int y = 0; y < YTILE; y++) {
  #pragma unroll
            for (int b = 0; b < A_CHUNK / 2; b++) {
              const uint32_t a2 = bigA[n][k2].u[b];
              const float a_lo = __uint_as_float(a2 << 16);
              const float a_hi = __uint_as_float(a2 & 0xffff0000u);
              const float w_lo = (float)bigB[y][k2].b[2 * b];
              const float w_hi = (float)bigB[y][k2].b[2 * b + 1];
              sum[n][y] += (a_lo * w_lo + a_hi * w_hi);
            }
          }
        }
      }
    }

    for (int n = 0; n < N; n++) {
      for (int y = 0; y < YTILE; y++) {
        sum[n][y] += __builtin_amdgcn_mov_dpp(sum[n][y], 0x118, 0xf, 0xf, 1);  // row_shr8
        sum[n][y] += __builtin_amdgcn_mov_dpp(sum[n][y], 0x114, 0xf, 0xf, 1);  // row_shr4
        sum[n][y] += __builtin_amdgcn_mov_dpp(sum[n][y], 0x112, 0xf, 0xf, 1);  // row_shr2
        sum[n][y] += __builtin_amdgcn_mov_dpp(sum[n][y], 0x111, 0xf, 0xf, 1);  // row_shr1
        sum[n][y] += __shfl_xor(sum[n][y], 16);
      }
    }

    if (threadIdx.x == (THRDS - 1)) {
      for (int n = 0; n < N; n++) {
        for (int y = 0; y < YTILE; y++) {
          C[m + y + n * M] = __float2bfloat16(sum[n][y] * S[m + y]);
        }
      }
    }
    m += CuCount * _WvPrGrp * YTILE;
  }
#endif
}

torch::Tensor wvSplitK_i8(const at::Tensor& in_w, const at::Tensor& in_s,
                          const at::Tensor& in_x, const int64_t CuCount,
                          const int64_t ytile, const int64_t unrl) {
