        LAUNCH_KB(32, 32, 8, "s4s4_g32_wmma_k8_32x32 launch failed");
        return output;
    }
    if (route == kRouteK4_32x64) {
        LAUNCH_KB(32, 64, 4, "s4s4_g32_wmma_k4_32x64 launch failed");
        return output;
    }
